{
  "name": "mingbang-engineering-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "safety": "node scripts/safety-check.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --test integration/*.test.mjs",
    "test:db-recovery": "node integration/验证断库恢复.mjs",
    "verify:deps": "npm ls --depth=0",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run preflight && npm run safety && npm run verify:boundaries && npm run verify:deps && npm run build && npm test",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
